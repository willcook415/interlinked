{
  "version": 8,
  "name": "Interlinked Light",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "gb-basemap": {
      "type": "vector",
      "tiles": ["__BASE_URL__/map/__COUNTRY_ISO2__/tiles/{z}/{x}/{y}.pbf"],
      "bounds": [-11.5, 49.3, 2.2, 61.2],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#c6ddf3"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "gb-basemap",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          ["wood", "forest"],
          "#e7efe4",
          ["grass", "grassland", "meadow", "farmland", "farmland_overlay"],
          "#f0f4eb",
          "#eef2ea"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.32, 10, 0.48]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "gb-basemap",
      "source-layer": "landuse",
      "minzoom": 5,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          ["park", "nature_reserve", "garden", "cemetery", "golf_course"],
          "#e8f1e4",
          ["residential"],
          "#f4f5f6",
          ["industrial", "railway"],
          "#eceff2",
          ["commercial", "retail"],
          "#f3efe8",
          ["school", "college", "university", "hospital"],
          "#eef2f7",
          "#f2f4f6"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.18, 12, 0.34]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "gb-basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d9e7f3"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#cadeef",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.3, 12, 1.1, 15, 2.2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "building-fill",
      "type": "fill",
      "source": "gb-basemap",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dfe4e8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.35, 16, 0.72]
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "line-color": "#cfd7dd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.2, 16, 0.8],
        "line-opacity": 0.85
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
        true,
        false
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.6,
          8,
          1.1,
          11,
          2.4,
          14,
          5.4,
          16,
          8.0
        ],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.65, 13, 0.95]
      }
    },
    {
      "id": "road-main",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
        true,
        false
      ],
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          ["motorway", "trunk"],
          "#6f7b88",
          ["primary"],
          "#7c8996",
          ["secondary"],
          "#919daa",
          ["tertiary"],
          "#a6b0b8",
          ["minor", "service"],
          "#bcc5cc",
          "#c8ced3"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.25,
          8,
          0.7,
          11,
          1.7,
          14,
          4.0,
          16,
          6.2
        ],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.62, 13, 0.96]
      }
    },
    {
      "id": "path-pedestrian",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["path", "track"],
        true,
        false
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#d2d7db",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 16, 1.2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "gb-basemap",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["rail", "transit"],
        true,
        false
      ],
      "paint": {
        "line-color": "#7c8793",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 10, 1.3, 14, 2.5],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.35, 12, 0.75]
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "water_name",
      "minzoom": 8,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 12, 11.5, 15, 13],
        "text-letter-spacing": 0.02,
        "text-keep-upright": true,
        "text-max-angle": 35,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#3b6b97",
        "text-halo-color": "rgba(250,252,255,0.99)",
        "text-halo-width": 1.35
      }
    },
    {
      "id": "place-city-major",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "place",
      "minzoom": 3,
      "filter": [
        "all",
        ["has", "name"],
        ["==", ["get", "class"], "city"],
        ["<=", ["coalesce", ["to-number", ["get", "rank"]], 99], 7]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 6, 13, 10, 17],
        "text-letter-spacing": 0.02,
        "text-max-width": 8,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "rank"]], 999]
      },
      "paint": {
        "text-color": "#173750",
        "text-halo-color": "rgba(250,252,255,0.99)",
        "text-halo-width": 1.7
      }
    },
    {
      "id": "place-city-secondary",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "place",
      "minzoom": 7,
      "filter": [
        "all",
        ["has", "name"],
        ["==", ["get", "class"], "city"],
        [">", ["coalesce", ["to-number", ["get", "rank"]], 99], 7],
        ["<=", ["coalesce", ["to-number", ["get", "rank"]], 99], 12]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 10, 13],
        "text-letter-spacing": 0.01,
        "text-max-width": 8,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "rank"]], 999]
      },
      "paint": {
        "text-color": "#24445d",
        "text-halo-color": "rgba(250,252,255,0.99)",
        "text-halo-width": 1.45
      }
    },
    {
      "id": "place-settlement",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "place",
      "minzoom": 10,
      "filter": [
        "all",
        ["has", "name"],
        [
          "match",
          ["get", "class"],
          ["town", "village", "suburb", "neighbourhood", "hamlet"],
          true,
          false
        ],
        ["<=", ["coalesce", ["to-number", ["get", "rank"]], 99], 14]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 9.5, 12, 11, 14, 12],
        "text-letter-spacing": 0.01,
        "text-max-width": 10,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "rank"]], 999]
      },
      "paint": {
        "text-color": "#35546c",
        "text-halo-color": "rgba(250,252,255,0.98)",
        "text-halo-width": 1.35
      }
    },
    {
      "id": "rail-label",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": [
        "all",
        ["any", ["has", "name"], ["has", "ref"]],
        ["match", ["get", "class"], ["rail", "transit"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 9.5, 13, 11.5],
        "text-letter-spacing": 0.02,
        "text-keep-upright": true,
        "text-max-angle": 35,
        "text-max-width": 12
      },
      "paint": {
        "text-color": "#434f5b",
        "text-halo-color": "rgba(250,252,255,0.98)",
        "text-halo-width": 1.25
      }
    },
    {
      "id": "road-label-major",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": [
        "all",
        ["any", ["has", "name"], ["has", "ref"]],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary"],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 13, 11.5, 15, 13],
        "text-letter-spacing": 0.01,
        "text-keep-upright": true,
        "text-max-angle": 35,
        "text-max-width": 14
      },
      "paint": {
        "text-color": "#465c70",
        "text-halo-color": "rgba(250,252,255,0.98)",
        "text-halo-width": 1.35
      }
    },
    {
      "id": "road-label-local",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": [
        "all",
        ["has", "name"],
        [
          "match",
          ["get", "class"],
          ["minor", "residential", "living_street"],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9.5, 15, 11],
        "text-letter-spacing": 0.005,
        "text-keep-upright": true,
        "text-max-angle": 35,
        "text-max-width": 16
      },
      "paint": {
        "text-color": "#5d6f80",
        "text-halo-color": "rgba(250,252,255,0.97)",
        "text-halo-width": 1.15
      }
    },
    {
      "id": "poi-major",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": [
        "all",
        ["has", "name"],
        ["<=", ["coalesce", ["to-number", ["get", "rank"]], 99], 3],
        [
          "!",
          [
            "match",
            ["get", "subclass"],
            [
              "bus_stop",
              "tram_stop",
              "platform",
              "stop_position",
              "crossing",
              "traffic_signals",
              "telephone",
              "post_box",
              "waste_basket",
              "bench",
              "street_lamp"
            ],
            true,
            false
          ]
        ]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 9.5, 15, 11.5],
        "text-letter-spacing": 0.01,
        "text-max-width": 14,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "rank"]], 999]
      },
      "paint": {
        "text-color": "#4c3f57",
        "text-halo-color": "rgba(250,252,255,0.98)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi-local",
      "type": "symbol",
      "source": "gb-basemap",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": [
        "all",
        ["has", "name"],
        ["<=", ["coalesce", ["to-number", ["get", "rank"]], 99], 5],
        [
          "!",
          [
            "match",
            ["get", "subclass"],
            [
              "bus_stop",
              "tram_stop",
              "platform",
              "stop_position",
              "crossing",
              "traffic_signals",
              "telephone",
              "post_box",
              "waste_basket",
              "bench",
              "street_lamp"
            ],
            true,
            false
          ]
        ]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 8.8, 16, 10],
        "text-letter-spacing": 0.005,
        "text-max-width": 16,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "rank"]], 999]
      },
      "paint": {
        "text-color": "#5b4f65",
        "text-halo-color": "rgba(250,252,255,0.97)",
        "text-halo-width": 1.05
      }
    }
  ]
}
